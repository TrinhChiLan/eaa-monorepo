# Constrained-edge profile for the EAA orchestrator.
# Install at /etc/eaa/eaa.env and adjust paths/values for the target.
#
# The 10 s flush lets the worker collect ~50 sensor rows at 5 Hz instead of the
# ~10 rows produced by the 2 s default. That is the largest flash-wear lever:
# measured logical WAL+checkpoint writes drop from ~16.6 KB/row to ~9.7 KB/row.
# Trade-off: at-most-once persistence can lose up to 10 s of audit rows on a
# crash. Command execution is in-memory and is not delayed by this window.

EAA_IPC_DIR=/run/eaa
EAA_DB_PATH=/var/lib/eaa/edge_system.db

# Batching / retention
EAA_DB_BATCH_SIZE=50
EAA_DB_FLUSH_INTERVAL=10
EAA_PRUNE_INTERVAL_SECONDS=300
EAA_RETENTION_MAX_ROWS=250000
EAA_RETENTION_MAX_AGE_DAYS=2

# Flash/space controls
EAA_DB_JOURNAL_LIMIT_BYTES=2097152
EAA_MIN_FREE_BYTES=67108864

EAA_LOG_LEVEL=INFO
PYTHONDONTWRITEBYTECODE=1
